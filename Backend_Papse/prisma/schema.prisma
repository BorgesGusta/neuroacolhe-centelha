generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BOLSISTA
}


model Paciente {
  idPaciente      Int       @id @default(autoincrement())
  nome            String    @db.VarChar(150)
  email           String    @db.VarChar(255)
  matricula       String    @db.VarChar(45)
  data_nascimento DateTime  @db.Date
  telefone        String?   @db.VarChar(11) 
  data_inscricao  DateTime  @db.Date
  relato          String?   @default("SEM RELATO") @db.VarChar(500)
  curso           String?   @db.VarChar(150)
  termo_lgpd Boolean @default(false)
  data_aceite_termo DateTime?
  ip_origem String? @db.VarChar(45)

  // Relações: Um paciente pode estar em várias listas/históricos
  ListaEspera ListaEspera[]
  ListaRegular ListaRegular[]
  Protocolo   Protocolo[]
  Regular     Regular[]
  Historico   Historico[]
  Relatorios  RelatorioEvolutivo[]
}

model Colaborador {
  idBolsista    Int      @id @default(autoincrement())
  nome          String   @db.VarChar(150)
  matricula     String   @db.VarChar(45) @unique
  email         String   @unique
  data_admissao DateTime @db.Date
  data_saida    DateTime? @db.Date
  senha         String   @db.VarChar(255)
  role          Role     @default(BOLSISTA)
  resetToken    String?
  resetTokenExpires DateTime?

  // Relações: Um colaborador pode estar em várias listas/históricos
  ListaRegular ListaRegular[]
  Protocolo    Protocolo[]
  Regular      Regular[]
  Historico    Historico[]
  Relatorios   RelatorioEvolutivo[]
}

model ListaEspera {
  idListaEspera Int @id @default(autoincrement())
  
  // Relação com Paciente
  idPaciente    Int
  paciente      Paciente @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)
}

model ListaRegular {
  idListaRegular Int @id @default(autoincrement())

  // Relação com Paciente
  idPaciente     Int
  paciente       Paciente @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)

  // Relação com Colaborador
  idBolsista     Int
  colaborador    Colaborador @relation(fields: [idBolsista], references: [idBolsista], onDelete: Restrict)
}

model Protocolo {
  idProtocolo             Int      @id @default(autoincrement())
  data_inicio_atendimento DateTime @db.Date
  qtde_sessoes            Int      @default(0)

  // Relação com Paciente
  idPaciente              Int
  paciente                Paciente @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)
  
  // Relação com Colaborador
  idBolsista              Int
  colaborador             Colaborador @relation(fields: [idBolsista], references: [idBolsista], onDelete: Restrict)
}

model Regular {
  idRegular               Int      @id @default(autoincrement())
  data_inicio_atendimento DateTime @db.Date
  qtde_sessoes            Int      @default(0)

  // Relação com Paciente
  idPaciente              Int
  paciente                Paciente @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)
  
  // Relação com Colaborador
  idBolsista              Int
  colaborador             Colaborador @relation(fields: [idBolsista], references: [idBolsista], onDelete: Restrict)
}

model Historico {
  idHistorico       Int       @id @default(autoincrement())
  data_desligamento DateTime? @db.Date

  // Relação com Paciente
  idPaciente        Int
  paciente          Paciente  @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)
  
  // Relação com Colaborador (último bolsista)
  id_ultimo_bolsista Int
  colaborador        Colaborador @relation(fields: [id_ultimo_bolsista], references: [idBolsista], onDelete: Restrict)
}

model RelatorioEvolutivo {
  idRelatorio     Int      @id @default(autoincrement())
  texto           String   @db.Text 
  data_criacao    DateTime @default(now())

  // Relação com Paciente
  idPaciente      Int
  paciente        Paciente @relation(fields: [idPaciente], references: [idPaciente], onDelete: Cascade)

  // Relação com Colaborador (quem escreveu)
  idBolsista      Int
  colaborador     Colaborador @relation(fields: [idBolsista], references: [idBolsista], onDelete: Restrict)
}