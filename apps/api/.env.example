# NeuroAcolhe API - Configurações de Ambiente

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configuração de Banco de Dados (PostgreSQL)
# Para uso local com docker-compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neuroacolhe_db?schema=public"

# Configurações de Autenticação
# Chave secreta longa e aleatória para assinatura dos tokens JWT
JWT_SECRET="sua_chave_secreta_jwt_aqui_para_desenvolvimento_local"

# Configurações de Envio de E-mail (Nodemailer)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=465
EMAIL_USER="seu-email@example.com"
EMAIL_PASS="sua-senha-de-email-ou-app-password"

# Configurações de Segurança
ALLOWED_ORIGINS="http://localhost:5173"
